# =======================================================
# Stage 1: Maven Build with Java 21
# =======================================================
FROM maven:3.9.9-eclipse-temurin-21 AS builder

WORKDIR /build

# Copy Protobuf schemas and Java application sources
COPY proto/ /build/proto/
COPY storage/ /build/storage/
COPY java-api/pom.xml /build/java-api/
COPY java-api/src/ /build/java-api/src/

WORKDIR /build/java-api

# Build Spring Boot executable fat JAR
RUN mvn clean package -DskipTests

# =======================================================
# Stage 2: Minimal Java 21 Runtime
# =======================================================
FROM eclipse-temurin:21-jre-jammy AS runtime

WORKDIR /app

# SQLite directory
RUN mkdir -p /app/storage

# Copy executable jar
COPY --from=builder /build/java-api/target/indexforge-java-api-*.jar /app/app.jar

ENV SERVER_PORT=8080 \
    INDEXFORGE_GRPC_HOST=cpp-engine \
    INDEXFORGE_GRPC_PORT=50051 \
    INDEXFORGE_STORAGE_DATABASE_PATH=/app/storage/metadata.db \
    INDEXFORGE_STORAGE_DOCUMENTS_DIR=/app/storage/documents

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/api/index/health || exit 1

ENTRYPOINT ["java", "-XX:+UseZGC", "-XX:+ZGenerational", "-Xms256m", "-Xmx512m", "-jar", "app.jar"]
